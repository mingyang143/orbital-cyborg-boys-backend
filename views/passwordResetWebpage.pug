doctype html
html
    head
        title Password Reset
    body
        h1 Password Reset
        form.resetPasswordForm(class="resetPasswordForm")
            label(for="password") New Password:
            input(type="password", class="password", name="password", required, minLength="8")
            label(for="confirmPassword") Confirm Password:
            input(type="password", class="passwordConfirm", name="confirmPassword", required, minLength="8")
            button(type="submit") Reset Password

            script(src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js")
            script.
                const form = document.querySelector('.resetPasswordForm');
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const password = document.querySelector('.password').value;
                    const passwordConfirm = document.querySelector('.passwordConfirm').value;
                    const token = "#{token}"
                    try {
                        const data = await axios.patch(`/api/v1/users/resetPassword/${token}`, { password, passwordConfirm });
                        alert('Password reset successful! Please log in with your new password.');
                        window.location.href = "https://orbital-cyborg-boys.netlify.app/";   
                    } catch (err) {
                        alert(err.response.data.message);
                    } finally{
                        form.reset();
                    }
                });